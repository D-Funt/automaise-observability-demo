{
  "title": "AI Use Cases - Operations Dashboard",
  "uid": "automaise-usecases",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Tasa de exito global",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(usecase_executions_total{status=\"success\"}[5m])) / sum(rate(usecase_executions_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Ejecuciones por canal (5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum by (channel) (rate(usecase_executions_total[5m]))",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Resolucion automatica vs escalado (por caso de uso)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "usecase_auto_resolution_rate",
          "legendFormat": "{{usecase}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Top casos de uso con mas fallos",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "topk(5, sum by (usecase) (rate(usecase_executions_total{status=\"failure\"}[5m])))",
          "legendFormat": "{{usecase}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latencia p95 por canal",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(usecase_execution_duration_seconds_bucket[5m])))",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Escalados a agente humano (por motivo)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (reason) (increase(usecase_escalations_total[15m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Total de ejecuciones (15m)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(usecase_executions_total[15m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
